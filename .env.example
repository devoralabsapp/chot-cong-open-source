# Copy to .env.local for local Emulator use. No cloud credentials needed.
APP_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=demo-chotcong
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-chotcong
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-chotcong.firebaseapp.com
# Optional web app identifiers (cloud config from Firebase console):
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Cloud: unset both emulator hosts; set real web config above.
# Server only: use Application Default Credentials (preferred), OR all 3 below.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
# Vercel Production without service-account keys (see docs/GCP_WIF_SETUP.md):
# FIREBASE_ADMIN_AUTH_MODE=vercel-oidc
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
# GCP_SERVICE_ACCOUNT_EMAIL=SERVICE_ACCOUNT@PROJECT_ID.iam.gserviceaccount.com
