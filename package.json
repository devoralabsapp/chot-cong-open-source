{
  "name": "chotcong",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "prebuild": "node --conditions=react-server --import tsx scripts/gcp/check-vercel-identity.ts",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration firebase/tests",
    "emulators": "node scripts/emulators.mjs start",
    "test:emulator": "node scripts/emulators.mjs test",
    "seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/firestore/seed.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check:public": "node scripts/check-public-deployment.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "backup:local": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/firestore/backup-restore/cli.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@vercel/oidc": "4.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "firebase-tools": "15.34.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "license": "MIT"
}
